#!/bin/sh
# Blocks commits that would leak the evaluation API key.
# Enable once per clone: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -qE '(^|/)\.env$'; then
  echo "pre-commit: refusing to commit a .env file" >&2
  exit 1
fi

# An API_KEY assignment or auth header carrying a real-looking value (16+ chars).
if git diff --cached -U0 -- . ':(exclude).githooks/*' | grep -E '^\+' \
  | grep -qiE '(API_KEY\s*[=:]\s*["'"'"']?[A-Za-z0-9_\-]{16,}|X-API-Key:\s*[A-Za-z0-9_\-]{16,}|Bearer\s+[A-Za-z0-9_\-]{24,})'; then
  echo "pre-commit: staged changes look like they contain an API key; remove it and read it from the environment" >&2
  exit 1
fi
